# Test environment configuration - DO NOT USE IN PRODUCTION
# This file is for local test harness only

# Database - Use local postgres from docker-compose
TEST_DB_URL=postgresql://postgres:postgres@localhost:5432/etpl_ops_test

# Auth secrets for testing only
JWT_SECRET=test-secret-for-testing-only-64-characters-long-hex-string-here
INTERNAL_OPS_JWT_SECRET=test-secret-for-testing-only-64-characters-long-hex-string-here
INTERNAL_OPS_REFRESH_SECRET=test-refresh-secret-for-testing-only-64-chars-hex
INTERNAL_OPS_ALLOWED_ORIGIN=http://localhost:3001

# Company config
COMPANY_STATE=Maharashtra
NODE_ENV=test

# Test-only flags
TEST_HARNESS=true
MOCK_BANK_ENABLED=true