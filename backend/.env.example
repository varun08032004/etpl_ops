# ── Database — Supabase (separate PROJECT from the platform DB, not just a separate schema) ──
# Get this from: Supabase Dashboard > your internal-ops project > Settings > Database > Connection string
# Use the "Direct connection" string (port 5432), not the pooled one (6543/pgbouncer) —
# this server holds a long-lived pg Pool and runs multi-statement transactions for the
# ledger, which the transaction pooler doesn't support cleanly.
INTERNAL_OPS_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Auth ──
INTERNAL_OPS_JWT_SECRET=change-me-to-a-64-char-random-hex-string
INTERNAL_OPS_REFRESH_SECRET=change-me-to-a-different-64-char-random-hex-string
INTERNAL_OPS_ALLOWED_ORIGIN=http://localhost:3001
ALLOW_BOOTSTRAP=false   # set true temporarily to create the first owner account, then set back to false
MAX_CONCURRENT_SESSIONS=5   # max simultaneous sessions per user

# ── Company GST config ──
COMPANY_STATE=Maharashtra   # your registered GST state — determines CGST+SGST vs IGST split

# ── Razorpay (payroll payouts — needs RazorpayX, a separate product from standard Razorpay Payments) ──
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# ── TrackPilot (attendance/activity sync) ──
TRACKPILOT_API_KEY=

# ── Email (Resend) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APP_BASE_URL=

# ── Email (SMTP for Document Engine) ──
INTERNAL_OPS_SMTP_HOST=
INTERNAL_OPS_SMTP_PORT=
INTERNAL_OPS_SMTP_USER=
INTERNAL_OPS_SMTP_PASS=
INTERNAL_OPS_SMTP_FROM=

# ── NVIDIA Nemotron (RAG) ──
# NVIDIA NIM (NVIDIA Inference Microservices) are SELF-HOSTED on your GPU infrastructure.
# 1. Deploy Nemotron NIM: https://docs.nvidia.com/nim/large-language-models/latest/getting-started.html
# 2. Set the NIM endpoint URLs below (replace with your NIM host:port)
# 3. Or use any OpenAI-compatible API (Ollama, vLLM, OpenAI, Azure OpenAI, etc.) via OPENAI_* vars
#
# Get API key from NVIDIA if using their hosted service, or use your NIM auth token
NVIDIA_API_KEY=
# NIM embedding endpoint (self-hosted) - e.g. http://your-gpu-server:8000/v1/embeddings
NVIDIA_EMBED_URL=
# NIM chat endpoint (self-hosted) - e.g. http://your-gpu-server:8000/v1/chat/completions
NVIDIA_CHAT_URL=
NEMOTRON_EMBED_MODEL=nvidia/nemotron-3-ultra-embed
NEMOTRON_CHAT_MODEL=nvidia/nemotron-3-ultra

# ── Alternative: OpenAI-compatible API (Ollama, vLLM, OpenAI, Azure, etc.) ──
# Use these if not self-hosting NVIDIA NIM
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_URL=https://api.openai.com/v1/embeddings
# OPENAI_EMBED_MODEL=text-embedding-3-large
# OPENAI_CHAT_URL=https://api.openai.com/v1/chat/completions
# OPENAI_CHAT_MODEL=gpt-4o

# RAG retrieval settings
USE_RAG=true
RAG_TOP_K=8
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_SIMILARITY_THRESHOLD=0.72
RAG_MAX_CONTEXT_TOKENS=4000
EMBED_DIMENSIONS=768

INTERNAL_OPS_PORT=5050
NODE_ENV=development