{
  "name": "ethertrack-internal-ops",
  "version": "0.1.0",
  "description": "EtherTrack internal ERP — HR, payroll disbursal (Razorpay), bookkeeping/accounting, GST invoicing. Separate from the customer-facing platform.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "psql \"$INTERNAL_OPS_DATABASE_URL\" -f db/schema.sql",
    "db:seed": "psql \"$INTERNAL_OPS_DATABASE_URL\" -f db/seed_chart_of_accounts.sql",
    "db:migrate:platform-sync": "psql \"$INTERNAL_OPS_DATABASE_URL\" -f db/002_platform_sync.sql",
    "db:migrate:document-engine": "psql \"$INTERNAL_OPS_DATABASE_URL\" -f db/004_document_engine.sql",
    "db:seed:document-templates": "psql \"$INTERNAL_OPS_DATABASE_URL\" -f db/seed_document_templates.sql",
    "db:migrate:rag": "psql \"$INTERNAL_OPS_DATABASE_URL\" -f db/rag_schema.sql",
    "db:migrate:accrual": "psql \"$INTERNAL_OPS_DATABASE_URL\" -f db/010_deferred_revenue_prepaid.sql",
    "rag:ingest": "node scripts/rag-ingest.js",
    "rag:ingest:full": "node scripts/rag-ingest.js full",
    "rag:ingest:templates": "node scripts/rag-ingest.js templates",
    "rag:ingest:generated": "node scripts/rag-ingest.js generated",
    "rag:ingest:documents": "node scripts/rag-ingest.js documents",
    "rag:ingest:compliance": "node scripts/rag-ingest.js compliance",
    "rag:ingest:appsettings": "node scripts/rag-ingest.js appsettings",
    "rag:ingest:tax": "node scripts/rag-ingest.js tax",
    "rag:ingest:pt": "node scripts/rag-ingest.js pt",
    "rag:ingest:company": "node scripts/rag-ingest.js company",
    "rag:health": "node scripts/rag-ingest.js health",
    "accrual:monthly": "node scripts/run-monthly-accrual.js",
    "cleanup:duplicates": "node scripts/cleanup-duplicate-bills.js",
    "cleanup:duplicates:execute": "node scripts/cleanup-duplicate-bills.js --execute",
    "fix:subscription-revenue": "node scripts/fix-subscription-revenue.js",
    "fix:subscription-revenue:execute": "node scripts/fix-subscription-revenue.js --execute",
    "fix:domain-prepaid": "node scripts/fix-domain-prepaid.js",
    "fix:domain-prepaid:execute": "node scripts/fix-domain-prepaid.js --execute"
  },
  "dependencies": {
    "@slack/bolt": "^5.0.0",
    "@slack/web-api": "^8.0.0",
    "archiver": "^8.0.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^5.6.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.15.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.3",
    "speakeasy": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "archiver": "^8.0.0",
    "uuid": "^11.1.1"
  }
}
