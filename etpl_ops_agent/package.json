{
  "name": "ethertrack-agent",
  "version": "0.1.0",
  "description": "EtherTrack desktop agent — attendance, activity tracking, idle detection for ETPL Ops",
  "main": "src/main.js",
  "author": "EtherTrack Technologies",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis",
    "dist:dir": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --dir"
  },
  "dependencies": {
    "active-win": "^8.2.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "in.ethertrack.agent",
    "productName": "EtherTrack Agent",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "assets/**/*", "config.json", "package.json"],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
